# Copy to .env and adjust. Used by docker compose.

COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000

# Browser-reachable noVNC (host ports mapped in compose)
WORKER_VNC_URLS=http://localhost:6081/vnc.html,http://localhost:6082/vnc.html

SESSION_TTL_SEC=600
WIDTH=1280
HEIGHT=800
