# Copy to .env and adjust. Used by docker compose.

COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000

# Browser-reachable noVNC (host ports mapped in compose)
# Local compose (direct ports). Behind Caddy HTTPS use e.g.:
# WORKER_VNC_URLS=https://cu1.hsv/vnc.html?autoconnect=1&resize=scale&path=&port=443,https://cu2.hsv/vnc.html?autoconnect=1&resize=scale&path=&port=443
WORKER_VNC_URLS=http://localhost:6081/vnc.html?autoconnect=1&resize=scale&path=,http://localhost:6082/vnc.html?autoconnect=1&resize=scale&path=

SESSION_TTL_SEC=600
# Parked (soft-released) desktops are wiped after this idle period
PARKED_TTL_SEC=1800
# Display: ASPECT_RATIO + WIDTH (HEIGHT is derived). Examples: 16:9, 16:10, 4:3
# Explicit HEIGHT overrides the derived value only if you clear ASPECT_RATIO.
ASPECT_RATIO=16:10
WIDTH=1280
# HEIGHT=
