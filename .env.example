# Copy to .env and adjust. Used by docker compose.

COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000

# Browser-reachable noVNC (host ports mapped in compose)
WORKER_VNC_URLS=http://localhost:6081/vnc.html?autoconnect=1&resize=scale,http://localhost:6082/vnc.html?autoconnect=1&resize=scale

SESSION_TTL_SEC=600
# Parked (soft-released) desktops are wiped after this idle period
PARKED_TTL_SEC=1800
# Display: ASPECT_RATIO + WIDTH (HEIGHT is derived). Examples: 16:9, 16:10, 4:3
# Explicit HEIGHT overrides the derived value only if you clear ASPECT_RATIO.
ASPECT_RATIO=16:10
WIDTH=1280
# HEIGHT=
