# Bearer token required when set (leave empty only for local dev)
COMPUTER_API_TOKEN=dev-token-change-me

# Public URL agents use in lease.api_base / OpenAPI
GATEWAY_PUBLIC_BASE=http://localhost:9000

# Comma-separated worker control APIs (internal Docker DNS or host ports)
WORKER_URLS=http://worker-1:8000,http://worker-2:8000

# Parallel list: browser-reachable noVNC URLs for humans / HITL
WORKER_VNC_URLS=http://localhost:6081/vnc.html?autoconnect=1&resize=scale,http://localhost:6082/vnc.html?autoconnect=1&resize=scale

# Default lease TTL (seconds); heartbeat extends. Expiry parks (no wipe).
SESSION_TTL_SEC=600

# Soft-released desktops idle this long before Firefox reset + free
PARKED_TTL_SEC=1800
